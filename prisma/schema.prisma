generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Favorite {
  id          String   @id @default(uuid())
  userId      String
  stationuuid String
  homepage    String
  tags        String
  name        String
  favicon     String?
  createdAt   DateTime @default(now())

  @@unique([userId, stationuuid])
}

model LastPlayed {
  userId      String   @id
  stationuuid String
  playedAt    DateTime @updatedAt
}